# CAI pentest agent configuration.
# Copy to .env and fill in your API key:  cp env.example .env

# Run CAI without an Alias Robotics license
CAI_LICENSE_OFF=1

# Model via OpenCode Go subscription (OpenAI-compatible endpoint).
# Get your key at https://opencode.ai/auth -> OpenCode Go -> API key.
# Swap to any other provider by changing CAI_MODEL + key vars, e.g.:
#   deepseek/deepseek-chat  + DEEPSEEK_API_KEY
#   openai/gpt-4o           + OPENAI_API_KEY
#   anthropic/claude-sonnet-4.5 + ANTHROPIC_API_KEY
CAI_MODEL=openai/deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_API_BASE=https://opencode.ai/zen/go/v1

# Allow fetch_url to reach RFC1918 targets (docker-compose networks)
CAI_FETCH_ALLOW_INTERNAL=true

# Skip startup update check and disable telemetry
CAI_SKIP_UPDATE_CHECK=1
CAI_TELEMETRY=false

# Agent type: redteam_agent (default) | bug_bounter_agent | blueteam_agent | network_security_analyzer_agent ...
CAI_AGENT_TYPE=redteam_agent
