{
  "simulator_connector_client": {
    "type": "mqtt",
    "mqtt": {
      "host": "mosquitto",
      "port": 1883
    }
  },
  "industrial_connector_client": {
    "type": "modbus",
    "modbus": {
      "host": "openplc",
      "port": 502,
      "slave": 1
    }
  },
  "simulator_names": [
    "peppermintvalve"
  ],
  "peppermintvalve": {
    "type": "valve",
    "tick_interval_seconds": 5,
    "logging": {
      "logging": true,
      "type": "opensearch",
      "opensearch": {
        "host": "opensearch",
        "port": 9200,
        "user": "admin",
        "password": "admin",
        "use_ssl": true,
        "verify_certs": false,
        "index": "factory-log-peppermintvalve",
        "max_size_cache": 10
      }
    },
    "inputs": [
      "peppermint"
    ],
    "outputs": [
      "mixtank1"
    ],
    "output_level": 100,
    "mapper_industry_properties": {
      "write": {
        "open": {
          "map": 803,
          "type": "coil"
        }
      },
      "read": {
        "open": {
          "map": 802,
          "type": "coil"
        }
      }
    }
  }
}