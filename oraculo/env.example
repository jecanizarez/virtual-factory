# Oraculo configuration.
# Copy to .env and fill in your API key:  cp env.example .env

# Model via OpenCode Go subscription (OpenAI-compatible endpoint).
# Swap provider by changing ORACULO_MODEL + key vars, e.g.:
#   deepseek/deepseek-chat        + DEEPSEEK_API_KEY
#   openai/gpt-4o                 + OPENAI_API_KEY
#   anthropic/claude-sonnet-4-5   + ANTHROPIC_API_KEY
#   ollama/qwen2.5:14b            + OLLAMA_API_BASE=http://host.docker.internal:11434
ORACULO_MODEL=openai/deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_API_BASE=https://opencode.ai/zen/go/v1

# Max tool-calling turns per question before forcing a final answer
ORACULO_MAX_TOOL_TURNS=6
